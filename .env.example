# Chef Lucas demo — HighLevel + Stripe placeholders
# Copy to .env.local. Leave blank to keep the site in demo mode.

# Show the demo-mode banner. Defaults to true unless this is explicitly "false"
# AND a booking webhook is configured.
NEXT_PUBLIC_DEMO_MODE=true

# --- GoHighLevel (LeadConnector) ---
# Inbound webhook or form endpoint from GHL → Workflows / Forms.
# Booking, contact, and shop checkout POST JSON here when set.
GHL_WEBHOOK_URL=
NEXT_PUBLIC_GHL_FORM_URL=
NEXT_PUBLIC_GHL_LOCATION_ID=

# Optional: embed a GHL calendar on /book (iframe src from Calendars → embed).
NEXT_PUBLIC_GHL_CALENDAR_EMBED_URL=

# One calendar per event type (audit recommendation). Used as calendarId on
# booking payloads so workflows can route into the right diary.
NEXT_PUBLIC_GHL_CALENDAR_WEDDING=
NEXT_PUBLIC_GHL_CALENDAR_CORPORATE=
NEXT_PUBLIC_GHL_CALENDAR_BUFFET=
NEXT_PUBLIC_GHL_CALENDAR_PRIVATE=
NEXT_PUBLIC_GHL_CALENDAR_TASTING=
NEXT_PUBLIC_GHL_CALENDAR_CUSTOM=

# FKIT Sales pipeline defaults (swap for the Chef Lucas location when live).
GHL_PIPELINE_ID=wbWmW9OBShOhEHUWEhC4
GHL_PIPELINE_STAGE_NEW_ENQUIRY=ba9f504a-48f4-43f3-aa0a-30984e275e8b

# --- Shop inventory (HighLevel Products API) ---
# Sub-account (location) used by GET /products/. FKIT demo default below.
GHL_LOCATION_ID=zpGOdJ2JYNkKfMpcko5l

# Private Integration Token for the FKIT location.
# Required scopes: products.readonly, products/collection.readonly,
# products/prices.readonly, **products/prices.write**
# If the token was created readonly-only, Ben must add products/prices.write
# in HighLevel, then redeploy/restart the Production env so Vercel picks it up.
# Set ONE of these on Vercel (Production). Never commit the value.
GHL_PRIVATE_API_TOKEN=
GHL_PRIVATE_INTEGRATION_TOKEN=

# Collection name to publish on /shop (created in GHL → Payments → Products).
GHL_PRODUCT_COLLECTION="Chef Lucas Demo"

# Optional stable collection ID once known (skips the name lookup).
# TODO(Alice): set this when Lois confirms the collection.
GHL_PRODUCT_COLLECTION_ID=

# Optional comma-separated HighLevel product IDs allowlist.
# TODO(Alice): ping with product IDs. Leave empty to filter by collection name.
# Do not put placeholder/fake IDs here — an empty list is the correct scaffold.
GHL_PRODUCT_IDS=

# --- Stripe (via GHL payments later; never charged by this demo) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
